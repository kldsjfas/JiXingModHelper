[Unit]
Description=JiXing Workshop isolated upload inbox
After=network.target

[Service]
Type=simple
User=jixing-workshop
Group=jixing-workshop
WorkingDirectory=/opt/jixing-workshop/current
EnvironmentFile=/etc/jixing-workshop.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/jixing-workshop/current/.venv-service/bin/python -B -m workshop_service.server --host 127.0.0.1 --port 19092
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jixing-workshop
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_UNIX
TasksMax=48
LimitNOFILE=128
MemoryMax=2G
TimeoutStopSec=200

[Install]
WantedBy=multi-user.target
